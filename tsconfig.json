{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",        
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types"],
    "lib": ["ES2020", "DOM"]              
  },
  "include": ["src/*.ts"],
  "exclude": ["node_modules", "dist"]
}